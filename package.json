{
  "name": "vidyapath",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=7168 next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:all": "npm run typecheck && npm run lint && npm run test",
    "check:ci": "npm run typecheck && npm run lint:strict && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:policy": "node scripts/audit_policy_check.mjs .audit-report.json security/audit-risk-register.json",
    "build:context": "npm run build:context:python",
    "build:context:node": "node scripts/build_context_index.mjs",
    "build:context:python": "node scripts/run_python.mjs scripts/build_context_index.py --max-files 0",
    "build:context:python:fast": "node scripts/run_python.mjs scripts/build_context_index.py --max-files 220",
    "build:textbooks": "node scripts/run_python.mjs scripts/build_textbook_index.py --merge-main-index",
    "build:vectors": "node scripts/build_vector_index.mjs",
    "filter:vectors": "node scripts/filter_vector_index.mjs",
    "build:retrieval-index": "node scripts/build_retrieval_index.mjs",
    "build:rag": "npm run build:context && npm run build:textbooks && npm run build:vectors && npm run build:retrieval-index && npm run write:rag-count",
    "build:rag:clean": "npm run build:context && npm run build:textbooks && npm run clean:chunks && npm run build:vectors && npm run build:retrieval-index && npm run write:rag-count",
    "build:rag:full": "node scripts/run_python.mjs scripts/build_rag_pipeline.py && npm run write:rag-count",
    "build:rag:full:no-download": "node scripts/run_python.mjs scripts/build_rag_pipeline.py --skip-downloads && npm run write:rag-count",
    "clean:chunks": "node scripts/clean_context_chunks.mjs && node scripts/sync_context_metadata.mjs",
    "sync:rag-metadata": "node scripts/sync_context_metadata.mjs",
    "write:rag-count": "node scripts/write_rag_count.mjs",
    "compress:context": "node scripts/compress_context.mjs",
    "verify:context": "node scripts/verify_context_index.mjs",
    "eval:rag": "vitest run lib/ai/__tests__/rag-benchmark.test.ts",
    "check:route-links": "node scripts/route_link_integrity.mjs",
    "check:function-sizes": "node scripts/check_function_trace_size.mjs",
    "check:data-quality": "node scripts/check_dataset_quality.mjs",
    "hf:upload:cbse": "python scripts/upload_to_hf.py --repo-id AdithyaSNair/cbse-papers-2009-2025 --folder dataset/cbse_papers",
    "hf:upload:ncert": "python scripts/upload_to_hf.py --repo-id AdithyaSNair/ncert-textbooks-10-12 --folder dataset/ncert_textbooks",
    "rag:rebuild": "node scripts/rag_rebuild.mjs",
    "rag:rebuild:fast": "node scripts/rag_rebuild.mjs --fast",
    "rag:rebuild:class10": "node scripts/rag_rebuild.mjs --skip-download --class 10",
    "rag:rebuild:class12": "node scripts/rag_rebuild.mjs --skip-download --class 12",
    "rag:vectors": "npm run build:vectors",
    "rag:index": "npm run build:retrieval-index",
    "rag:bench": "npm run eval:rag",
    "rag:build": "node scripts/rag_build.mjs",
    "rag:build:force": "node scripts/rag_build.mjs --force",
    "rag:build:qp-only": "node scripts/rag_build.mjs --skip-textbooks --skip-benchmark",
    "rag:build:tb-only": "node scripts/rag_build.mjs --skip-qp --skip-benchmark",
    "rag:build:class10": "node scripts/rag_build.mjs --class 10",
    "rag:build:class12": "node scripts/rag_build.mjs --class 12",
    "rag:build:no-bench": "node scripts/rag_build.mjs --skip-benchmark",
    "check:context-deploy": "node scripts/check_context_deploy.mjs",
    "prebuild": "npm run check:context-deploy",
    "postbuild": "node scripts/prune_function_traces.mjs && node scripts/check_function_trace_size.mjs",
    "report:retrieval": "node scripts/generate_retrieval_report.mjs",
    "eval:rag:report": "node scripts/eval_rag_report.mjs",
    "rag:repair": "node scripts/reindex.mjs",
    "rag:repair:apply": "node scripts/reindex.mjs --apply",
    "export:semantic": "node scripts/export_semantic_release.mjs",
    "test:retrieval-service": "node --test services/retrieval/server.test.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.78.0",
    "@serwist/next": "^9.5.13",
    "@upstash/redis": "^1.37.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.400.0",
    "mermaid": "^12.3.0",
    "next": "16.4.6",
    "pino": "^10.3.1",
    "postcss": "8.5.26",
    "react": "^18",
    "react-dom": "^18",
    "react-katex": "^3.1.0",
    "serwist": "^9.5.13",
    "swr": "^2.4.1",
    "ts-fsrs": "^5.3.2",
    "use-debounce": "^10.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.12",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-katex": "^3.0.4",
    "autoprefixer": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "null-loader": "^4.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "uuid": "^14.0.0",
    "next": {
      ".": "16.4.6",
      "postcss": "8.5.26"
    },
    "zod": "^4.6.7",
    "sharp": "^0.35.5",
    "fast-uri": "^3.1.9",
    "source-map-js": "^1.2.2",
    "glob": "^14.0.6",
    "minimatch": "^11.0.8",
    "katex": "$katex"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
