# VidyaPath public study platform. Static material requires no secrets or database.
# Copy relevant values to .env.local; never commit real secrets.
# Full instructions: docs/AI_SECURITY_AND_RETRIEVAL.md

NEXT_PUBLIC_APP_URL=https://vidyapath.in
# CSRF_ALLOWED_ORIGINS=https://vidyapath.in,https://www.vidyapath.in

# Operator-only console; random value of at least 24 characters, server-side only.
# DEVELOPER_DASHBOARD_KEY=replace-with-a-long-random-secret

# At least one usable provider for AI. Account quotas/billing determine actual cost.
# The image solver specifically needs Gemini.
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# CEREBRAS_API_KEY=explicit-opt-in-only-model-requires-billing
# AI_TASK_MODEL_MAP={"chat":["GEMINI_35_FLASH_LITE","GROQ_GPT_OSS_120B"]}
# AI_IMAGE_SOLVE_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_CHAR_BUDGET=24000
# AI_RESPONSE_CACHE=0
# AI_ENABLE_SELF_VERIFY=0

# Required for production AI: shared limits/budget. Configured failures block calls.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=server-only-token
# AI_PUBLIC_DAILY_REQUESTS_PER_IP=120
# AI_DAILY_TOKEN_BUDGET_GLOBAL=1000000
# Includes actual instructions/context/history + maximum output per provider attempt.
# Vision needs its image allowance too; a 9000 override will block vision requests.
# AI_MAX_TOKENS_PER_REQUEST=16000

# Bundled gzip + BM25 is the default and requires no inference API.
# Hosted reranking uses query + candidate passages; valid NVIDIA key enables it unless 0.
# AI_ENABLE_NVIDIA_RERANK=0
# AI_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
# Optional budgeted query expansion; evidence compression is always extractive.
# AI_ENABLE_RETRIEVAL_LLM=1
# AI_RETRIEVAL_HELPER_PROVIDER=groq
# AI_RETRIEVAL_HELPER_GROQ_MODEL=openai/gpt-oss-20b

# Free local semantic build; downloads weights and uses host CPU/RAM.
# VECTOR_PROVIDER=local
# LOCAL_EMBED_MODEL=Xenova/multilingual-e5-small
# Query encoder on long-running Node/Docker only; disabled on Vercel.
# AI_ENABLE_LOCAL_EMBEDDINGS=1
# Hosted embedding alternative (quota/trial/billing applies):
# VECTOR_PROVIDER=nvidia
# AI_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# Optional private vector backend and storage upload credentials; never NEXT_PUBLIC_.
# Apply supabase/migrations/20261114000100_optional_rag_vector_store.sql first.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-never-public
# AI_VECTOR_BACKEND=supabase
# Alternative: private VM service for the existing E5 corpus, no external DB required.
# AI_VECTOR_BACKEND=remote
# RETRIEVAL_SERVICE_URL=https://retrieval.your-domain.example
# RETRIEVAL_SERVICE_KEY=random-server-only-secret-at-least-32-characters
# RAG_VECTOR_CORPUS_ID=your-immutable-corpus-id
# Encoder identity/dimension must match documents: 384 local or 2048 NVIDIA.

# Optional immutable public academic-corpus CDN, local-first and hash-checked.
# Preview: node scripts/upload_context_to_storage.mjs
# Upload: node --env-file=.env.local scripts/upload_context_to_storage.mjs --apply
# CONTEXT_CDN_URL=https://your-project.supabase.co/storage/v1/object/public/context/releases/<fingerprint>

# Optional separate local text-injection service. Configured outage blocks AI.
# AI_INJECTION_GUARD_URL=http://127.0.0.1:8899/classify
# AI_INJECTION_GUARD_TOKEN=random-server-only-token

# Non-Vercel production: trust only a header overwritten by your restricted proxy.
# Unconfigured origins share an unknown-IP bucket. Never trust arbitrary forwarding.
# TRUSTED_PROXY_HEADER=x-forwarded-for
# TRUSTED_PROXY_HOPS=1

# Optional monitoring: payload/auth redaction and no session replay.
# LOG_LEVEL=info
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-name
# SENTRY_AUTH_TOKEN=server-only-source-map-upload-token
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-analytics.example/script.js
# CSP_ALLOW_UNSAFE_INLINE_STYLE=0
