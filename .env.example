# =============================================================================
# VidyaPath — Environment Variables
# Copy to .env.local and fill in your values.
# =============================================================================

# ── REQUIRED ────────────────────────────────────────────────────────────────
# HMAC secret for signing all role session cookies. Must be ≥32 random chars.
SESSION_SIGNING_SECRET=replace_with_long_random_string_min_32_chars

# Shared secret for teacher portal login.
TEACHER_PORTAL_KEY=replace_with_teacher_secret


# ── Supabase (auth + database) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key


# ── AI Providers (at least one required) ─────────────────────────────────────
# Groq — free tier, 14,400 req/day. Sign up: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini — free tier available. https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM — embeddings + reranking. https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenAI — fallback embeddings (text-embedding-3-small)
# OPENAI_API_KEY=sk-your_openai_key


# ── Deployment ──────────────────────────────────────────────────────────────
# Canonical app URL for CSRF origin pinning and metadata. Required in production.
NEXT_PUBLIC_APP_URL=https://vidyapath.in

# Comma-separated additional allowed origins for CSRF.
# CSRF_ALLOWED_ORIGINS=https://vidyapath.in,https://www.vidyapath.in

# Must be 0 in production. Enables unified admin+developer shell in dev.
SINGLE_ENV_MODE=0

# Must be false in production. Migration-only compatibility path.
AUTH_ENABLE_LEGACY_SESSIONS=false

# Fails build when required env vars are missing. Set to 1 in CI/production.
STRICT_ENV_VALIDATION=0


# ── Developer Access ────────────────────────────────────────────────────────
# Required in production — has no secure default.
DEVELOPER_USERNAME=
DEVELOPER_PASSWORD=


# ── Redis / Rate Limiting (recommended for production) ──────────────────────
# Sign up free: https://upstash.com → Redis → REST API
# UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Rate-limit fallback on DB errors: fail-open in dev, fail-closed in prod.
# RATE_LIMIT_FAIL_OPEN=false


# ── AI Tuning (optional) ────────────────────────────────────────────────────
# Model routing: JSON map of task → model priority list
# AI_TASK_MODEL_MAP={"chat":["G4","M27","GLM5"],"mcq":["G4","GLM5"]}

# Enable NVIDIA reranker for context retrieval quality
# AI_ENABLE_NVIDIA_RERANK=1
# AI_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2

# Token budget guardrails
# AI_MAX_TOKENS_PER_REQUEST=4000
# AI_DAILY_TOKEN_BUDGET_PER_SCHOOL=100000
# AI_DAILY_TOKEN_BUDGET_GLOBAL=1000000


# ── pgvector RAG (optional, requires Supabase pgvector extension) ────────────
# AI_ENABLE_PGVECTOR_RAG=1
# Apply migration 20260418000600_pgvector_document_embeddings.sql first, then ingest embeddings.


# ── Email Delivery (optional, uses Resend) ───────────────────────────────────
# RESEND_API_KEY=re_your_resend_key
# AUTH_MAIL_FROM=VidyaPath Auth <auth@your-domain.com>


# ── Push Notifications (optional) ───────────────────────────────────────────
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_CONTACT_EMAIL=admin@vidyapath.in


# ── Observability ───────────────────────────────────────────────────────────
# LOG_LEVEL=info    (trace | debug | info | warn | error | fatal | silent)
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-domain/script.js

# Error tracking — Sentry (recommended for production)
# Free tier: https://sentry.io → create project → get DSN from Settings
# SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-name
# SENTRY_AUTH_TOKEN=***  (needed for source map uploads in CI)
# SENTRY_ENVIRONMENT=production
# Fallback: plain webhook for error alerts (Slack, Discord, etc.)
# OBSERVABILITY_ALERT_WEBHOOK_URL=https://hooks.slack.com/...

# ── RAG Context CDN (recommended for production) ───────────────────────────
# Upload lib/context/* to Supabase Storage or CDN and set:
# CONTEXT_CDN_URL=https://your-bucket.supabase.co/storage/v1/object/public/context
# When set, chunks are streamed from CDN instead of bundled in the Docker image.


# ── Misc ─────────────────────────────────────────────────────────────────────
# DEFAULT_SCHOOL_CODE=VIDYAPATH-001
# SUPABASE_STATE_TABLE=app_state
# SUPABASE_STATE_SCHEMA=public
# CRON_SECRET=your_cron_secret_for_webhook_triggers
# CSP_ALLOW_UNSAFE_INLINE_STYLE=0
